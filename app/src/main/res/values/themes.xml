<resources>
    <style name="Theme.Echo" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Paints the cold-start window in the design system's page colour, so there is no
             white flash before Compose draws. -->
        <item name="android:windowBackground">@color/surface_page</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
