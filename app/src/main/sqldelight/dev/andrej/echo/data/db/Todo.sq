import kotlin.Boolean;

CREATE TABLE todo (
    id TEXT NOT NULL PRIMARY KEY,
    sourceTranscriptId TEXT NOT NULL,
    text TEXT NOT NULL,
    dueAt INTEGER NOT NULL,
    hasTime INTEGER AS Boolean NOT NULL,
    hasDate INTEGER AS Boolean NOT NULL,
    done INTEGER AS Boolean NOT NULL,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    sourceOffsetMs INTEGER,
    reminderAt INTEGER,
    reminderDate TEXT,
    reminderDelivered INTEGER AS Boolean NOT NULL DEFAULT 0,
    sourceQuote TEXT,
    -- Checked, edited or snoozed by the user; re-analysis keeps these rows as they are.
    touched INTEGER AS Boolean NOT NULL DEFAULT 0
);

CREATE INDEX todo_source ON todo(sourceTranscriptId);

selectAll:
SELECT * FROM todo ORDER BY dueAt, hasTime DESC, createdAt;

selectById:
SELECT * FROM todo WHERE id = ?;

selectFor:
SELECT * FROM todo WHERE sourceTranscriptId = ?;

updateReminder:
UPDATE todo SET reminderAt = ?, reminderDate = ?, reminderDelivered = ? WHERE id = ?;

deliverReminder:
UPDATE todo SET reminderDelivered = 1 WHERE id = ?;

retryReminder:
UPDATE todo SET reminderDelivered = 0 WHERE id = ? AND reminderAt = ?;

doneFor:
SELECT id, done FROM todo WHERE sourceTranscriptId = ?;

insert:
INSERT INTO todo VALUES ?;

snooze:
UPDATE todo SET dueAt = ?, reminderAt = ?, reminderDate = NULL, reminderDelivered = 0, updatedAt = ?, touched = 1 WHERE id = ?;

setDone:
UPDATE todo SET done = ?, updatedAt = ?, touched = 1 WHERE id = ?;

update:
UPDATE todo SET text = ?, dueAt = ?, hasTime = ?, hasDate = ?, updatedAt = ?, touched = 1 WHERE id = ?;

delete:
DELETE FROM todo WHERE id = ?;

deleteFor:
DELETE FROM todo WHERE sourceTranscriptId = ?;

deleteUntouchedFor:
DELETE FROM todo WHERE sourceTranscriptId = ? AND touched = 0;

clear:
DELETE FROM todo;
