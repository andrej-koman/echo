CREATE TABLE transcript (
    id TEXT NOT NULL PRIMARY KEY,
    text TEXT NOT NULL,
    language TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    durationMs INTEGER NOT NULL,
    title TEXT,
    summary TEXT,
    analyzedAt INTEGER,
    -- Unused: polishing was removed. Platform SQLite before 3.35 cannot DROP COLUMN.
    polishedText TEXT,
    folderId TEXT
);

selectAll:
SELECT id, text, language, createdAt, durationMs, title, summary, analyzedAt, folderId
FROM transcript ORDER BY createdAt DESC;

insert:
INSERT INTO transcript (id, text, language, createdAt, durationMs, title)
VALUES (?, ?, ?, ?, ?, ?);

setTranscription:
UPDATE transcript SET text = ?, language = ?, durationMs = ? WHERE id = ?;

attachAnalysis:
UPDATE transcript SET title = ?, summary = ?, analyzedAt = ? WHERE id = ?;

delete:
DELETE FROM transcript WHERE id = ?;

clear:
DELETE FROM transcript;

search:
SELECT id FROM transcript
WHERE title LIKE '%' || :text || '%' ESCAPE '\' OR summary LIKE '%' || :text || '%' ESCAPE '\'
UNION
SELECT transcriptId FROM segment_fts WHERE segment_fts MATCH :match;

setText:
UPDATE transcript SET text = ? WHERE id = ?;

setFolder:
UPDATE transcript SET folderId = ? WHERE id = ?;

unfile:
UPDATE transcript SET folderId = NULL WHERE folderId = ?;
